# ───────────────────────────────────────────────────────────────
# 复制为 .env 后填写，并 chmod 600 .env。绝不要提交到 git。
# ───────────────────────────────────────────────────────────────

# DRY_RUN（默认，纯模拟、零真钱）或 LIVE（真实下单，Phase 2）
MODE=DRY_RUN

# 目标钱包：必须是 Polymarket 个人主页上的**完整 42 位代理钱包地址**，不能是 0xb27b...b82 这类缩写
TARGET_WALLET=

# 监控数据源：chain（读 Polygon 链上日志，需要 POLYGON_RPC_URL）或 dataapi（Polymarket Data API，无需 Key）
# 留空则：配了 POLYGON_RPC_URL 用 chain，否则用 dataapi
MONITOR_SOURCE=
POLYGON_RPC_URL=

# CONFIRM（默认，更保守：目标钱包信号 + 自有规则 1-3 双确认）或 COPY_ONLY（目标钱包信号直接触发，仅过风控）
CONFIRM_MODE=CONFIRM

# ── 资金与风控（百分比写法：10 表示 10%）──
BANKROLL_USD=20
MAX_POSITION_PCT=5
MAX_DAILY_LOSS_PCT=10
MAX_TOTAL_DRAWDOWN_PCT=20

# ── Telegram 告警（可选；LIVE + REQUIRE_APPROVAL=true 时必填）──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 仅 MODE=LIVE 使用（DRY_RUN 下这些变量即便填了也会被忽略）──
# PRIVATE_KEY=              # 由你在服务器上手动写入；绝不进 git、绝不进日志
# CLOB_FUNDER_ADDRESS=      # Polymarket 账户（代理钱包）地址
# CLOB_SIGNATURE_TYPE=1     # 1=邮箱/Magic 账户，2=Gnosis Safe，0=纯 EOA
# REQUIRE_APPROVAL=true     # 每单需 Telegram /approve（首周建议保持开启）
